# Arslanlı Danışmanlık - Apache yapılandırması
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Yapay zekâ erişimi (/mcp): "Authorization: Bearer ..." başlığı CGI/FastCGI/FPM'de PHP'ye ulaşmayabilir; üç yol birden açık.
# 1) Apache 2.4.13+: başlığı PHP'ye ilet. (Barındırma firmanız bu satır yüzünden 500 hatası verirse bu bloğu silin; aşağıdaki iki yol yeterlidir.)
<IfModule mod_version.c>
  <IfVersion >= 2.4.13>
    CGIPassAuth On
  </IfVersion>
</IfModule>
# 2) Eski yöntem: başlığı ortam değişkenine kopyala (PHP'de HTTP_AUTHORIZATION ya da REDIRECT_HTTP_AUTHORIZATION olarak okunur)
<IfModule mod_setenvif.c>
  SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # 3) Aynı işi mod_rewrite ile yapan yaygın yedek
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # HTTPS'e ve www'siz adrese yönlendirme (yerel geliştirmede uygulanmaz).
  # Sunucuda SSL kurulu değilse (ör. geçici deneme adresi) bu altı satırın başına # koyun; yoksa site açılmaz.
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # app/ ve storage/ klasörlerine doğrudan erişimi engelle
  RewriteRule ^(app|storage)(/|$) - [F,L]
  # Nokta ile başlayan dosya ve klasörler (.git, .gitignore, .user.ini...) sunulmaz; /.well-known/ adresleri hariç
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

  # Var olan dosyalar (css, js, görseller) doğrudan sunulur, kalan her şey index.php'ye gider
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Kurulum notları ve kayıt dosyaları dışarıdan okunamasın.
# Not: Apache erişim denetimi mod_rewrite'tan ÖNCE çalışır. Eskiden tüm .md ve .json dosyaları yasaktı; bu yüzden /index.md, /hizmetler.md
# (sayfaların Markdown sürümü) ve /feed.json gibi PHP ile üretilen adresler 403 veriyordu. Artık yalnızca gerçekten hassas olanlar kapalı:
# diskteki kurulum notu (KURULUM.md; yeni bir .md dosyası eklenirse adı buraya yazılır), .user.ini, günlük/kayıt dosyaları (sunucunun PHP hata
# günlüğü error_log dahil) ve betikler. storage/ ve app/ zaten yukarıdaki RewriteRule ile ve kendi .htaccess dosyalarıyla kapalıdır.
<FilesMatch "^(KURULUM\.md|\.user\.ini|error_log)$|\.(log|jsonl|sh|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5 MB özgeçmiş yüklemesi için PHP sınırları (Apache mod_php kullanan sunucularda; FPM'de .user.ini geçerlidir)
# Hata iletileri ziyaretçiye gösterilmez, sunucunun hata günlüğüne yazılır.
<IfModule mod_php.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 10M
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 10M
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

# Apache'nin doğrudan sunduğu dosyalarda (css, js, görseller) güvenlik başlıkları; PHP sayfalarında nosniff index.php'den gelir
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/markdown text/plain application/json application/feed+json application/rss+xml text/calendar
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
